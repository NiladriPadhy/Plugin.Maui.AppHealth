<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net10.0-android;net10.0-ios</TargetFrameworks>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>

		<RootNamespace>Plugin.Maui.AppHealth</RootNamespace>
		<AssemblyName>Plugin.Maui.AppHealth</AssemblyName>
		<PackageId>Plugin.Maui.AppHealth</PackageId>
		<Title>.NET MAUI AppHealth Plugin</Title>
		<Description>Detect app, device, and environment problems in .NET MAUI on Android and iOS. Inspect battery, storage, memory, thermal state, network, and runtime conditions, then watch for changes.</Description>
		<PackageTags>dotnet-maui;maui;app-health;diagnostics;battery;storage;memory;thermal;network;android;ios;plugin</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/NiladriPadhy/Plugin.Maui.AppHealth</PackageProjectUrl>
		<RepositoryUrl>https://github.com/NiladriPadhy/Plugin.Maui.AppHealth</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Authors>NugetWorld</Authors>
		<Company>NugetWorld</Company>
		<Copyright>Copyright © NugetWorld</Copyright>
		<Version>1.0.0</Version>
		<PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts</PackageOutputPath>
		<IsPackable>true</IsPackable>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<PackageReleaseNotes>Initial release: inspect and watch battery, power mode, storage, memory, thermal, network, device, and app runtime problems on Android and iOS.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Plugin.Maui.AppHealth.Tests" />
	</ItemGroup>

</Project>
